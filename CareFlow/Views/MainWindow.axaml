<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CareFlow.ViewModels"
        xmlns:models="using:CareFlow.Models"
        x:Class="CareFlow.Views.MainWindow"
        x:DataType="vm:CareFlowViewModel"
        Title="CareFlow - Diagnostic Booking"
        Width="900"
        Height="750"
        MinWidth="650"
        MinHeight="550">

	<ScrollViewer>
		<StackPanel Margin="24" Spacing="16">

			<TextBlock Text="CareFlow"
                       FontSize="30"
                       FontWeight="Bold" />

			<TextBlock Text="Diagnostic Booking Management"
                       FontSize="16" />

			<StackPanel Spacing="14"
                        IsEnabled="{Binding IsNotBusy}">

				<TextBlock Text="1. Choose a booking date"
                           FontWeight="Bold" />

				<DatePicker SelectedDate="{Binding SelectedDate,
                                                      Mode=TwoWay}"
                            HorizontalAlignment="Left" />

				<Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Padding="20,10" />

				<TextBlock Text="After changing the date, click Refresh."
                           TextWrapping="Wrap" />

				<TextBlock Text="2. Select an existing patient"
                           FontWeight="Bold" />

				<ComboBox ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient,
                                                 Mode=TwoWay}"
                          PlaceholderText="Select a patient"
                          HorizontalAlignment="Stretch">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="models:Patient">
							<TextBlock Text="{Binding FullName}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<TextBlock Text="3. Select one to three different services"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />

				<ItemsControl ItemsSource="{Binding Services}">
					<ItemsControl.ItemTemplate>
						<DataTemplate
                            x:DataType="vm:ServiceSelectionViewModel">

							<CheckBox Content="{Binding DisplayText}"
                                      IsChecked="{Binding IsSelected,
                                                          Mode=TwoWay}"
                                      IsEnabled="{Binding IsAvailable}"
                                      Margin="0,4" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Button Content="Confirm Booking"
                        Command="{Binding ConfirmBookingCommand}"
                        Padding="20,10" />

			</StackPanel>

			<Border Padding="12"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6">

				<TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap" />
			</Border>

			<ProgressBar IsVisible="{Binding IsBusy}"
                         IsIndeterminate="True"
                         Height="4" />

			<TextBlock Text="Confirmed Bookings"
                       FontSize="22"
                       FontWeight="Bold" />

			<TextBlock Text="Saved bookings appear below after refreshing."
                       TextWrapping="Wrap" />

			<ItemsControl ItemsSource="{Binding Bookings}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="models:BookingSummary">

						<Border Padding="14"
                                Margin="0,0,0,10"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="6">

							<StackPanel Spacing="6">

								<StackPanel Orientation="Horizontal"
                                            Spacing="6">
									<TextBlock Text="Booking #"
                                               FontWeight="Bold" />
									<TextBlock Text="{Binding BookingId}"
                                               FontWeight="Bold" />
								</StackPanel>

								<TextBlock Text="{Binding PatientName}"
                                           FontSize="16"
                                           FontWeight="Bold" />

								<StackPanel Orientation="Horizontal"
                                            Spacing="6">
									<TextBlock Text="Date:" />
									<TextBlock
                                        Text="{Binding BookingDateText}" />
								</StackPanel>

								<TextBlock Text="{Binding ServicesText}"
                                           TextWrapping="Wrap" />

							</StackPanel>
						</Border>

					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

		</StackPanel>
	</ScrollViewer>
</Window>